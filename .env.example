# Copy this file to .env and fill in real values. Never commit .env.

# --- Get your own (free tier) ---
# Groq API key, used by the analyst/feedback/weekly-summary LLM calls.
# Sign up free at https://console.groq.com
GROQ_API_KEY=

# --- Shared company values — ask whoever owns Silversea's shared secrets ---
# Gmail sender address for the (optional) email digest.
GMAIL_USER=
# Gmail app password (not your regular Gmail password — generate one at
# https://myaccount.google.com/apppasswords).
GMAIL_APP_PASSWORD=
# Comma-separated list of email addresses to receive the digest.
RECIPIENT_EMAILS=
# Shared team password for viewing the dashboard. If left unset, the app
# silently seeds data/viewer_password.txt with the literal string "changeme"
# on first run and uses that as the de facto viewer password.
VIEWER_PASSWORD=
# Admin password, gates /admin (source-approval queue, viewer-password
# rotation). If left unset, admin login is refused entirely — this is a
# real value you need from the team, not a placeholder to skip.
ADMIN_PASSWORD=
